# FraudTrace AI — Backend Environment Template
# Copy this file to backend/.env if you want to override defaults.
# .env.example IS committed to Git. .env files MUST NEVER be committed.

# SQLAlchemy database connection URL
# Relative SQLite paths resolve relative to backend/ regardless of working directory.
DATABASE_URL=sqlite:///./data/fraudtrace.db

# Target API URL used by backend/seed_demo_data.py (optional override)
FRAUDTRACE_API_URL=http://127.0.0.1:8000
