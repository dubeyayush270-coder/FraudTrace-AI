# FraudTrace AI — Backend Environment Template
# Copy this file to backend/.env if you want to override defaults.
# .env.example IS committed to Git. .env files MUST NEVER be committed.

# SQLAlchemy database connection URL
# Relative SQLite paths resolve relative to backend/ regardless of working directory.
DATABASE_URL=sqlite:///./data/fraudtrace.db

# Target API URL used by backend/seed_demo_data.py (optional override)
FRAUDTRACE_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AI Investigation Assistant (Optional — Disabled by Default)
# ---------------------------------------------------------------------------
# Leave AI_ENABLED=false when running offline or without a Gemini API key.
AI_ENABLED=false
AI_PROVIDER=gemini

# NEVER commit a real API key to Git. Set this only in your local backend/.env.
GEMINI_API_KEY=

# Implementation default Gemini model in ai_provider.py is `gemini-3.8-flash`
# (overrideable via env, e.g., `gemini-3.7-flash` used in live fallback/latency testing).
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq fallback (triggered ONLY if Gemini returns HTTP 503 or ReadTimeout
# when GROQ_API_KEY is set; other HTTP errors and timeout subtypes do not trigger fallback).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1500

# Privacy gate: only 'synthetic_demo' data may be sent to external LLM endpoints
# by default. Free-tier Gemini API requests may be used by Google to improve its
# products; NEVER send real customer PII or confidential production records.
AI_DATA_CLASSIFICATION=synthetic_demo
AI_ALLOW_EXTERNAL_NON_DEMO=false

# ---------------------------------------------------------------------------
# PayPal Sandbox Orders v2 Integration (Optional — Sandbox Only)
# ---------------------------------------------------------------------------
# Use PayPal Sandbox credentials ONLY (never production/live credentials).
# NEVER expose PAYPAL_CLIENT_ID or PAYPAL_CLIENT_SECRET in frontend VITE_* variables,
# and NEVER commit real credential values to Git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
