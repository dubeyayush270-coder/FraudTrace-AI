# FraudTrace AI — Environment variable template
# Copy this file to .env and fill in the values.
# .env.example IS committed to Git. .env is NOT.
#
# IMPORTANT: Never put secrets (API keys, passwords, tokens) in VITE_ variables.
# VITE_ variables are embedded into the browser JavaScript bundle and are
# visible to anyone who inspects the page source. Only public values belong here.

VITE_API_URL=http://127.0.0.1:8000
